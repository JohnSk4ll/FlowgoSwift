[Language]
Name = C++
Extension = cpp
Indent = 4
Keywords = class, def, return, for, if, while, int, float, double, long, boolean, bool, true, false, public, static, void, main, import, std
Conflicts = fgInput, fgIn, fgOut, fgRandom, fgText, fgBool, fgFixed, fgX, fgY, fgAngle, fgColor, fgLines, fgSVG, fgForward, fgHome, fgEOF, draw
Options = aligned

[Types]
Integer = long long
Real = double
Boolean = bool
String = std::string
None = void

[Function ID]
Convention = camel
Normal = {name}
Conflict = user_{name}

[Variable ID]
Convention = camel
Normal = {name}
Conflict = user_{name}

[String Literal]
Text = "{characters}"
Replace Char 1 = "
Replace By 1 = \"
Replace Char 2 = \
Replace By 2 = \\

[Integer Literal]
Text = {integral}

[Real Literal]
Text = {integral}.{fractional}

[Boolean Literal]
true = true
false = false

[Variable Access]
Precedence = 100
Text = {name} | ~subscript
 = {name}.at({subscript}) | subscript

[Or]
Precedence = 1
Needed 1 = 1
Needed 2 = 2
Text = {1} {pipe} {2}

[And]
Precedence = 2
Needed 1 = 2
Needed 2 = 3
Text = {1} & {2}

[Equals]
Precedence = 4
Needed 1 = 4
Needed 2 = 5
Text = {1} == {2}

[Not Equals]
Precedence = 4
Needed 1 = 4
Needed 2 = 5
Text = {1} != {2}

[Less Than]
Precedence = 4
Needed 1 = 4
Needed 2 = 5
Text = {1} < {2}

[Less Equal Than]
Precedence = 4
Needed 1 = 4
Needed 2 = 5
Text = {1} <= {2}

[Greater Than]
Precedence = 4
Needed 1 = 4
Needed 2 = 5
Text = {1} > {2}

[Greater Equal Than]
Precedence = 4
Needed 1 = 4
Needed 2 = 5
Text = {1} >= {2}

[Add]
Precedence = 5
Needed 1 = 5
Needed 2 = 6
Text = {1} + {2}

[Subtract]
Precedence = 5
Needed 1 = 5
Needed 2 = 6
Text = {1} - {2}

[Multiply]
Precedence = 6
Needed 1 = 6
Needed 2 = 7
Text = {1} * {2}

[Divide]
Precedence = 6
Needed 1 = 6
Needed 2 = 7
Text = {1} / {2}
Cast 1 = real | integer-integer

[Modulus]
Precedence = 6
Needed 1 = 6
Needed 2 = 7
Text = std::fmod({1}, {2}) | ~integer-integer
 = {1} % {2} | integer-integer

[Concatenate]
Precedence = 100
Text = fgText({1}) + fgText({2})
Type = string

[Power]
Precedence = 100
Text = std::pow({1}, {2})

[Not]
Precedence = 7
Needed 1 = 8
Text = !{1}

[Negate]
Precedence = 7
Needed 1 = 8
Text = -{1}

[Cast]
Precedence = 100
Needed = 0
Text = static_cast<double>({expression}) | integer-to-real
 = fgText({expression}) | integer-to-string
 = static_cast<bool>({expression}) | integer-to-boolean
 = static_cast<long long>({expression}) | real-to-integer
 = fgText({expression}) | real-to-string
 = static_cast<bool>({expression}) | real-to-boolean
 = std::stoll({expression}) | string-to-integer
 = std::stod({expression}) | string-to-real
 = fgBool({expression}) | string-to-boolean
 = static_cast<long long>({expression}) | boolean-to-integer
 = static_cast<double>({expression}) | boolean-to-real
 = fgText({expression}) | boolean-to-string

[Abs]
Precedence = 100
Text = std::abs({1})

[Sqrt]
Precedence = 100
Text = std::sqrt({1})

[Sin]
Precedence = 100
Text = std::sin({1})

[Cos]
Precedence = 100
Text = std::cos({1})

[Tan]
Precedence = 100
Text = std::tan({1})

