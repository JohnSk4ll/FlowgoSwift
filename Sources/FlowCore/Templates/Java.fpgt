[Program]
Text = import java.util.*;
 = import java.io.*;
 = class Program {{ | ~aligned | 
 = class Program | aligned | 
 = {{ | aligned | 
 = static final Scanner fgInput = new Scanner(System.in); | | 1
 = static Scanner fgIn; | | 1
 = static PrintWriter fgOut; | | 1
 = static final Random fgRandom = new Random(); | | 1
 = static <T> T fgValue(T value) {{ return Objects.requireNonNull(value, "Uninitialized variable"); } | | 1
 = static String fgText(Object value) {{ | | 1
 = if (value instanceof Boolean) return ((Boolean)value) ? "True" : "False"; | | 2
 = if (value instanceof Double && ((Double)value) % 1 == 0) return String.format(java.util.Locale.ROOT, "%.0f", (Double)value); | | 2
 = return String.valueOf(value); | | 2
 = } | | 1
 = static boolean fgBool(String value) {{ | | 1
 = if (!value.equalsIgnoreCase("true") && !value.equalsIgnoreCase("false")) throw new IllegalArgumentException("Enter True or False"); | | 2
 = return Boolean.parseBoolean(value); | | 2
 = } | | 1
 = static String fgFixed(double value, long digits) {{ return String.format(java.util.Locale.ROOT, "%." + digits + "f", value); } | | 1
 = static double fgX = 0, fgY = 0, fgAngle = 90; | | 1
 = static String fgColor = "#101010"; | | 1
 = static ArrayList<String> fgLines = new ArrayList<>(); | | 1
 = static void fgSVG() throws IOException {{ | | 1
 = try (PrintWriter svg = new PrintWriter("turtle.svg", "UTF-8")) {{ | | 2
 = svg.println("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-1000 -1000 2000 2000\">"); | | 3
 = for (String line : fgLines) svg.println(line); | | 3
 = svg.println("</svg>"); | | 3
 = } | | 2
 = } | | 1
 = static void fgForward(double distance, boolean pen) throws IOException {{ | | 1
 = double x = Math.max(-1000000, Math.min(1000000, fgX + Math.cos(Math.toRadians(fgAngle)) * distance)); | | 2
 = double y = Math.max(-1000000, Math.min(1000000, fgY - Math.sin(Math.toRadians(fgAngle)) * distance)); | | 2
 = if (pen) fgLines.add("<line x1=\"" + fgX + "\" y1=\"" + fgY + "\" x2=\"" + x + "\" y2=\"" + y + "\" stroke=\"" + fgColor + "\"/>"); | | 2
 = fgX = x; fgY = y; fgSVG(); | | 2
 = } | | 1
 = static void fgHome() {{ fgX = fgY = 0; fgAngle = 90; } | | 1
 = -->MAIN | | 1
 = -->FUNCTIONS | | 1
 = }

